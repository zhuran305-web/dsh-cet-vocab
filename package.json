{
  "name": "dsh-cet-vocab",
  "version": "0.1.6",
  "description": "背单词（四六级）：shell.overlay 悬浮词卡，可拖动、可最小化；三键评分（认识/模糊/不认识）+ 艾宾浩斯间隔复习；词库 5805 词（四级 3849 / 六级 5407），内嵌自 ECDICT（MIT）。随时点开背单词。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "zhuran305-web",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuran305-web/dsh-cet-vocab.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale/zh.json",
    "locale/en.json",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cet4",
    "cet6",
    "vocabulary",
    "english",
    "四六级",
    "背单词",
    "单词卡"
  ],
  "dsh": {
    "category": "extension",
    "displayName": "背单词",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
